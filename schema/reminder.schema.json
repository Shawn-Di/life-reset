{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/life-reset/life-reset/schema/reminder.schema.json",
  "title": "Life-reset content pack",
  "type": "object",
  "required": ["version", "defaultModuleId", "modules"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "defaultModuleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/module"
      }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "slots"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "sourceUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "sourcePublishedAt": {
          "type": "string",
          "format": "date"
        },
        "summary": { "type": "string", "minLength": 1 },
        "copyrightNote": { "type": "string", "minLength": 1 },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["time", "prompt", "action"],
            "additionalProperties": false,
            "properties": {
              "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
              "prompt": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
